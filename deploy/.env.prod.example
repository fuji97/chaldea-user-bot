# Copy to deploy/.env.prod on sparkle, chmod 600, fill every value.
STACK=chaldeabot
IMAGE_TAG=stable
HTTP_PORT=5000
# Live volume kept from the current stack — confirm the exact name with `docker volume ls`
DB_VOLUME=chaldeabot_dbdata
# MUST equal the password already initialised inside DB_VOLUME (copy from the old .env)
POSTGRES_PASSWORD=
BOT_KEY=
TELEGRAM_ADMIN_USER_ID=
BASE_URL=https://chaldeabot.example.com
BASE_PATH=/telegram/
ENDPOINT=chaldeabot
WEBHOOK_SECRET=
RAYSHIFT_API_KEY=
ADMIN_API_KEY=
LOG_LEVEL_DEFAULT=Warning
