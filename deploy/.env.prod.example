# Copy to deploy/.env.prod on sparkle, chmod 600, fill every value.
STACK=chaldeabot
IMAGE_TAG=stable
# Existing external Pangolin Docker network. The prod target remains chaldeabot_bot:5000.
PANGOLIN_NETWORK=pangolin
# Live volume retained from the current stack.
DB_VOLUME=chaldeabot_dbdata_16
# MUST equal the password already initialised inside DB_VOLUME (copy from the old .env)
POSTGRES_PASSWORD=
BOT_KEY=
TELEGRAM_ADMIN_USER_ID=
BASE_URL=https://chaldeabot.federicorapetti.it
BASE_PATH=/telegram/
ENDPOINT=chaldeabot
WEBHOOK_SECRET=
RAYSHIFT_API_KEY=
ADMIN_API_KEY=
LOG_LEVEL_DEFAULT=Warning
