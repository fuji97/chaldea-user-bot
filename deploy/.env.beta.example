# Copy to deploy/.env.beta on sparkle, chmod 600, fill every value.
STACK=chaldeabot_beta
IMAGE_TAG=beta
# Existing external Pangolin Docker network. Add a target chaldeabot_beta_bot:5000.
PANGOLIN_NETWORK=pangolin
# External volume must pre-exist: `docker volume create chaldeabot_beta_dbdata`
DB_VOLUME=chaldeabot_beta_dbdata
POSTGRES_PASSWORD=
# chaldeabot_beta bot token, separate from the prod bot
BOT_KEY=
TELEGRAM_ADMIN_USER_ID=
BASE_URL=https://chaldeabot.federicorapetti.it
BASE_PATH=/telegram/
ENDPOINT=chaldeabot_beta
WEBHOOK_SECRET=
RAYSHIFT_API_KEY=
ADMIN_API_KEY=
LOG_LEVEL_DEFAULT=Debug
